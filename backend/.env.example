# Copy this file to .env and fill in real values before running in any
# non-throwaway environment. Never commit a real .env file.

DATABASE_URL=sqlite:///./dhaara.db

# Path to trained YOLO weights (.pt). If missing/unset, YOLODetector cannot
# be constructed (see services/cv/detector.py) - use SimulationDetector for
# development until real weights are available.
MODEL_PATH=./models_store/yolov8n.pt

# Default video source for the demo intersection. Can be an uploaded file
# path, or ignored entirely once you wire a webcam/RTSP source instead.
VIDEO_SOURCE=./videos/sample_intersection.mp4

# Detection confidence thresholds (0-1)
DETECTION__YOLO_CONFIDENCE=0.45
DETECTION__HELMET_CONFIDENCE=0.55
DETECTION__AMBULANCE_CONFIDENCE=0.60
DETECTION__AMBULANCE_CONFIRMATION_FRAMES=8
DETECTION__AMBULANCE_CONFIRMATION_WINDOW_S=4.0

# Signal timings (seconds)
SIGNAL_TIMINGS__MINIMUM_GREEN_S=10
SIGNAL_TIMINGS__MAXIMUM_GREEN_S=60
SIGNAL_TIMINGS__BASE_GREEN_S=15
SIGNAL_TIMINGS__YELLOW_S=3
SIGNAL_TIMINGS__ALL_RED_S=2
SIGNAL_TIMINGS__FIXED_PHASE_S=30

FAIRNESS__CONSECUTIVE_PRIORITY_LIMIT=3

# Auth - CHANGE SECRET_KEY before any real deployment.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list is not supported directly by pydantic-settings list
# parsing from .env; set via JSON array string if overriding:
# CORS_ORIGINS=["http://localhost:3000"]
