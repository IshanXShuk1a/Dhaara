DATABASE_URL=sqlite:///./dhaara.db
MODEL_PATH=./models_store/yolov8n.pt

# Four independent directional camera videos. Relative paths resolve under backend/.
# Supply real footage; missing files are OFFLINE and never use another source.
EAST_VIDEO=./videos/east.mp4
WEST_VIDEO=./videos/west.mp4
NORTH_VIDEO=./videos/north.mp4
SOUTH_VIDEO=./videos/south.mp4

# Normalized [x,y] vertices: far-left, far-right, near-right, near-left.
# Mark the far cross-line 30 ft (9.144 m) from the signal using measured road landmarks.
# Pixel geometry alone cannot establish a real-world distance.
EAST_ROI=[[0.35,0.20],[0.65,0.20],[0.90,0.90],[0.10,0.90]]
WEST_ROI=[[0.35,0.20],[0.65,0.20],[0.90,0.90],[0.10,0.90]]
NORTH_ROI=[[0.35,0.20],[0.65,0.20],[0.90,0.90],[0.10,0.90]]
SOUTH_ROI=[[0.35,0.20],[0.65,0.20],[0.90,0.90],[0.10,0.90]]

DETECTION__YOLO_CONFIDENCE=0.45
DETECTION__HELMET_CONFIDENCE=0.55
DETECTION__AMBULANCE_CONFIDENCE=0.60
DETECTION__AMBULANCE_CONFIRMATION_FRAMES=8
DETECTION__AMBULANCE_CONFIRMATION_WINDOW_S=4.0

# EW and NS alternate every 70 seconds in normal operation.
SIGNAL_TIMINGS__FIXED_PHASE_S=70
SIGNAL_TIMINGS__YELLOW_S=3
SIGNAL_TIMINGS__SCORE_DIFFERENCE_THRESHOLD=20
SIGNAL_TIMINGS__EMPTY_SCORE_MAX=5
SIGNAL_TIMINGS__EARLY_SWITCH_MIN_REMAINING_S=20
SIGNAL_TIMINGS__EMPTY_PERSISTENCE_S=3
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
# CORS_ORIGINS=["http://localhost:3000"]
